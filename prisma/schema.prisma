  lastSyncedAt          DateTime?
  backfillClaimedAt     DateTime?
  backfillClaimToken    String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  threads               MessagingThread[]
  messages              MessagingMessage[]
  calendars             Calendar[]
  calendarEvents        CalendarEvent[]
  inboundEvents         MessagingInboundEvent[]
  accountActivities     AccountActivity[]
  mailboxCredential     MailboxCredential?
  mailboxCalendarEvents MailboxCalendarEvent[]

  @@index([companyId])
  @@index([userId])
  @@index([companyId, provider])
}

