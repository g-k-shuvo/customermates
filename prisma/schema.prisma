  connectedAccountId  String                @unique
  connectedAccount    ConnectedAccount      @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  imapHost            String
  imapPort            Int
  imapSecure          Boolean               @default(true)
  smtpHost            String?
  smtpPort            Int?
  smtpSecure          Boolean?
  username            String
  sealedSecret        String
  oauthProvider       MailboxOAuthProvider?
  calendarSyncEnabled Boolean               @default(false)
  calendarSyncCursor  String?
  calendarSyncedAt    DateTime?
  syncCursors         Json                  @default("[]")
  backfillFrom        DateTime?
  lastSyncedAt        DateTime?
  lastVerifiedAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([companyId])
}

model MessagingThread {
  id                  String                       @id @default(uuid())
  companyId           String
  company             Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccountId  String
  connectedAccount    ConnectedAccount             @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  state               MessagingThreadState         @default(unread)
  type                MessagingThreadType          @default(single)
  name                String?
  unipileThreadId     String
  unipileThreadAltId  String?
  provider            MessagingProvider
  subject             String?
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  lastMessageIsSender Boolean?
  sharedToCrm         Boolean                      @default(false)
  linkedDealId        String?
  linkedDeal          Deal?                        @relation(fields: [linkedDealId], references: [id], onDelete: SetNull)
  archivedAt          DateTime?
  followUpAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  messages            MessagingMessage[]
  participants        MessagingThreadParticipant[]
  drafts              MailDraft[]
  outboxMessages      MailOutboxMessage[]
  labels              MessagingThreadLabel[]

  @@unique([connectedAccountId, unipileThreadId])
  @@index([companyId])
  @@index([companyId, state])
  @@index([companyId, lastMessageAt(sort: Desc)])
  @@index([companyId, sharedToCrm])
  @@index([companyId, linkedDealId])
  @@index([connectedAccountId, unipileThreadAltId])
}

model MessagingThreadParticipant {
  id                String            @id @default(uuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagingThreadId String
  thread            MessagingThread   @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  provider          MessagingProvider
  providerUserId    String
  identifier        String?
  displayName       String?
  pictureUrl        String?
  profileUrl        String?
  headline          String?
  occupation        String?
  isSelf            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([messagingThreadId, providerUserId])
  @@unique([messagingThreadId, identifier])
  @@index([companyId])
  @@index([messagingThreadId])
  @@index([companyId, provider, identifier])
}

model MessagingMessage {
  id                 String                    @id @default(uuid())
  companyId          String
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagingThreadId  String
  thread             MessagingThread           @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount          @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  unipileMessageId   String
  providerMessageId  String?
  provider           MessagingProvider
  direction          MessagingMessageDirection
  origin             MessagingMessageOrigin
  sender             Json
  senderIdentifier   String?
  recipients         Json                      @default("{}")
  reactions          Json                      @default("[]")
  subject            String?
  bodyText           String?
  bodyHtml           String?
  attachmentsMeta    Json                      @default("[]")
  attachments        MailAttachment[]
  folderIds          String[]                  @default([])
  isEvent            Boolean                   @default(false)
  isDeleted          Boolean                   @default(false)
  isHidden           Boolean                   @default(false)
  isDraft            Boolean                   @default(false)
  sentAt             DateTime
  editedAt           DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([connectedAccountId, unipileMessageId])
  @@index([companyId])
  @@index([messagingThreadId, sentAt])
  @@index([companyId, provider, senderIdentifier])
  @@index([folderIds], type: Gin)
}

enum MessageKind {
