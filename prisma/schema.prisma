model ConnectedAccount {
  id                    String                  @id @default(uuid())
  companyId             String
  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  unipileAccountId      String                  @unique
  provider              MessagingProvider
  status                ConnectedAccountStatus  @default(connecting)
  hasMessaging          Boolean                 @default(false)
  hasCalendar           Boolean                 @default(false)
  emailAddress          String?
  displayName           String?
  sentFolderIds         String[]                @default([])
  folders               Json                    @default("[]")
  selectedFolderIds     String[]                @default([])
  foldersSyncedAt       DateTime?
  linkedinProducts      String[]                @default([])
  signature             String?
  signatureFields       Json?
  shared                Boolean                 @default(false)
  syncing               Boolean                 @default(false)
