  status           RecordFileStatus @default(pending)
  uploadedByUserId String?
  createdAt        DateTime         @default(now())
  completedAt      DateTime?
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deal             Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead             Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  uploadedBy       User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, status, createdAt])
  @@index([contactId])
  @@index([organizationId])
  @@index([dealId])
  @@index([leadId])
}

enum RecordDocumentStatus {
  draft
  sent
  completed
  declined
  voided
}

enum RecordDocumentSigningProvider {
  docusign
}

enum RecordDocumentEnvelopeStatus {
  sent
  delivered
  completed
  declined
  voided
}

enum RecordDocumentFileKind {
  original
  signed
}

enum RecordDocumentFileStatus {
  pending
  ready
}

model RecordDocument {
  id                 String                         @id @default(uuid())
  companyId          String
  entityType         EntityType
  contactId          String?
  organizationId     String?
  dealId             String?
  title              String
  status             RecordDocumentStatus           @default(draft)
  statusChangedAt    DateTime                       @default(now())
  signingProvider    RecordDocumentSigningProvider?
  envelopeId         String?                        @unique
  envelopeStatus     RecordDocumentEnvelopeStatus?
  envelopeSentAt     DateTime?
  envelopeRecipients Json?
  createdByUserId    String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  company            Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact            Contact?                       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization       Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deal               Deal?                          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy          User?                          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  files              RecordDocumentFile[]

  @@index([companyId])
  @@index([contactId])
  @@index([organizationId])
  @@index([dealId])
}

model RecordDocumentFile {
  id               String                   @id @default(uuid())
  companyId        String
  documentId       String
  kind             RecordDocumentFileKind
  storageKey       String                   @unique
  fileName         String
  byteSize         Int
  status           RecordDocumentFileStatus @default(pending)
  uploadedByUserId String?
  createdAt        DateTime                 @default(now())
  completedAt      DateTime?
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document         RecordDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User?                    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([documentId, kind, status])
  @@index([companyId, status, createdAt])
}

enum DuplicateScanStatus {
  running
  completed
  failed
}

enum DuplicateGroupStatus {
  open
  dismissed
  merged
}

enum DuplicateMatchKeyKind {
  emailLocalPart
  emailDomainSurname
  phoneLast7
  nameKey
  nameSoundKey
  organizationSurname
  organizationNameKey
  organizationSoundKey
  organizationDomain
}

model DuplicateScan {
  id              String              @id @default(uuid())
  companyId       String
  entityType      EntityType
  status          DuplicateScanStatus @default(running)
  startedByUserId String?
  recordCount     Int                 @default(0)
  groupCount      Int                 @default(0)
  skippedBuckets  Json?
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startedBy       User?               @relation(fields: [startedByUserId], references: [id], onDelete: SetNull)
  groups          DuplicateGroup[]

  @@index([companyId, entityType, startedAt])
}

model DuplicateGroup {
  id          String                  @id @default(uuid())
  companyId   String
  scanId      String?
  entityType  EntityType
  fingerprint String
  status      DuplicateGroupStatus    @default(open)
  score       Float
  signals     DuplicateMatchKeyKind[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scan        DuplicateScan?          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  members     DuplicateMember[]

  @@unique([scanId, fingerprint])
  @@index([companyId, entityType, status])
}

model DuplicateMember {
  id             String         @id @default(uuid())
  companyId      String
  groupId        String
  contactId      String?
  organizationId String?
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group          DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@unique([groupId, organizationId])
  @@index([companyId])
  @@index([contactId])
  @@index([organizationId])
}

model DuplicateDismissal {
  id                String     @id @default(uuid())
  companyId         String
  entityType        EntityType
  leftId            String
  rightId           String
  dismissedByUserId String?
  createdAt         DateTime   @default(now())
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dismissedBy       User?      @relation(fields: [dismissedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, entityType, leftId, rightId])
}

model ContactMatchKey {
  id             String                @id @default(uuid())
  companyId      String
  entityType     EntityType
  contactId      String?
  organizationId String?
  kind           DuplicateMatchKeyKind
  value          String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact        Contact?              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, kind, value])
  @@index([contactId])
  @@index([organizationId])
}

model ContactMergeRecord {
  id             String    @id @default(uuid())
  companyId      String
  winnerId       String?
  loserIds       String[]
  groupId        String?
  snapshot       Json
  mergedByUserId String?
  undoneByUserId String?
  createdAt      DateTime  @default(now())
  undoneAt       DateTime?
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  winner         Contact?  @relation(fields: [winnerId], references: [id], onDelete: SetNull)
  mergedBy       User?     @relation("ContactMergeRecordMergedBy", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  undoneBy       User?     @relation("ContactMergeRecordUndoneBy", fields: [undoneByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([winnerId])
}

model OrganizationMergeRecord {
  id             String    @id @default(uuid())
  companyId      String
  winnerId       String?
  loserIds       String[]
  groupId        String?
  snapshot       Json
  mergedByUserId String?
  undoneByUserId String?
  createdAt      DateTime  @default(now())
  undoneAt       DateTime?
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([winnerId])
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

model InvoiceSettings {
  id               String   @id @default(uuid())
  companyId        String   @unique
  sellerName       String   @default("")
  sellerAddress    String   @default("")
  sellerVatId      String?
  sellerEmail      String?
  sellerPhone      String?
  bankDetails      String?
  footer           String?
  numberPrefix     String   @default("INV-")
  nextNumber       Int      @default(1)
  paymentTermsDays Int      @default(14)
  defaultTaxRate   Decimal  @default(19) @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model BillingProfile {
  id             String       @id @default(uuid())
  companyId      String
  organizationId String       @unique
  legalName      String       @default("")
  address        String       @default("")
  vatId          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Invoice {
  id              String           @id @default(uuid())
  companyId       String
  number          String?
  status          InvoiceStatus    @default(draft)
  dealId          String?
  organizationId  String?
  currency        Currency
  issueDate       DateTime?        @db.Date
  dueDate         DateTime?        @db.Date
  buyerName       String           @default("")
  buyerAddress    String           @default("")
  buyerVatId      String?
  buyerEmail      String?
  sellerSnapshot  Json?
  notes           String?
  netTotal        Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal          @default(0) @db.Decimal(14, 2)
  grossTotal      Decimal          @default(0) @db.Decimal(14, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(14, 2)
  paidAt          DateTime?
  issuedAt        DateTime?
  voidedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal            Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lines           InvoiceLine[]
  payments        InvoicePayment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([dealId])
  @@index([organizationId])
}

model InvoiceLine {
  id              String  @id @default(uuid())
  companyId       String
  invoiceId       String
  position        Int
  description     String
  quantity        Decimal @db.Decimal(14, 4)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @db.Decimal(5, 2)
  netAmount       Decimal @db.Decimal(14, 2)
  taxAmount       Decimal @db.Decimal(14, 2)
  serviceId       String?
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId, position])
}

model InvoicePayment {
  id              String   @id @default(uuid())
  companyId       String
  invoiceId       String
  amount          Decimal  @db.Decimal(14, 2)
  paidAt          DateTime
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
}

enum BulkJobKind {
  contactListFill
  campaignSend
}

enum BulkJobStatus {
  running
  completed
  failed
  cancelled
}

model BulkJob {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          BulkJobKind
  status        BulkJobStatus @default(running)
  subjectId     String
  definition    Json
  cursor        String?
  processed     Int           @default(0)
  expectedTotal Int?
  finalTotal    Int?
  stale         Boolean       @default(false)
  error         String?
  createdById   String?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, kind, subjectId])
}

model ContactList {
  id          String              @id @default(uuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     ContactListMember[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ContactListMember {
  id        String      @id @default(uuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listId    String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedById String?
  jobId     String?
  createdAt DateTime    @default(now())

  @@unique([listId, contactId])
  @@index([companyId])
  @@index([contactId])
}

enum CampaignStatus {
  draft
  sending
  sent
  cancelled
  failed
}

enum CampaignRecipientStatus {
  pending
  sent
  suppressed
  failed
  skipped
}

model Campaign {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  status          CampaignStatus      @default(draft)
  subject         String              @default("")
  bodyMarkdown    String              @default("")
  bannerUrl       String?
  audience        Json
  lawfulBasis     String?
  senderUserId    String?
  createdById     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  sentCount       Int                 @default(0)
  suppressedCount Int                 @default(0)
  failedCount     Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  recipients      CampaignRecipient[]

  @@index([companyId])
  @@index([companyId, status])
}

model CampaignRecipient {
  id         String                  @id @default(uuid())
  companyId  String
  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  email      String
  status     CampaignRecipientStatus @default(pending)
  deliveryId String?
  error      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([campaignId, contactId])
  @@index([companyId])
  @@index([campaignId, status])
}

enum LeadAssignmentStrategy {
  specificUser
  roundRobin
}

model LeadAssignmentRule {
  id                 String                 @id @default(uuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  position           Int                    @default(0)
  enabled            Boolean                @default(true)
  conditions         Json
  strategy           LeadAssignmentStrategy
  userIds            String[]
  lastAssignedUserId String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([companyId, position])
}

enum MailComposeMode {
  reply
  forward
}

enum MailOutboxStatus {
  scheduled
  sending
  sent
  failed
  cancelled
}

model MailDraft {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId            String
  messagingThreadId String
  thread            MessagingThread @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  mode              MailComposeMode @default(reply)
  replyAll          Boolean         @default(false)
  body              String          @default("")
  recipients        String[]        @default([])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, messagingThreadId])
  @@index([companyId])
}

model MailOutboxMessage {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId            String
  messagingThreadId String
  thread            MessagingThread  @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  mode              MailComposeMode  @default(reply)
  replyAll          Boolean          @default(false)
  body              String
  recipients        String[]         @default([])
  status            MailOutboxStatus @default(scheduled)
  sendAt            DateTime
  attempts          Int              @default(0)
  lastError         String?
  claimedAt         DateTime?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companyId])
  @@index([status, sendAt])
  @@index([companyId, userId, status])
}

model MailLabel {
  id        String                 @id @default(uuid())
  companyId String
  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  color     String                 @default("secondary")
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  threads   MessagingThreadLabel[]

  @@unique([companyId, name])
  @@index([companyId])
}

model MessagingThreadLabel {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messagingThreadId String
  thread            MessagingThread @relation(fields: [messagingThreadId], references: [id], onDelete: Cascade)
  mailLabelId       String
  label             MailLabel       @relation(fields: [mailLabelId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([messagingThreadId, mailLabelId])
  @@index([companyId])
  @@index([mailLabelId])
}

model MailboxCalendarEvent {
  id                 String                        @id @default(uuid())
  companyId          String
  company            Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedAccountId String
  connectedAccount   ConnectedAccount              @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  providerEventId    String
  title              String?
  location           String?
  startsAt           DateTime
  endsAt             DateTime
  allDay             Boolean                       @default(false)
  cancelled          Boolean                       @default(false)
  organizerEmail     String?
  attendees          Json                          @default("[]")
  webLink            String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  contacts           MailboxCalendarEventContact[]

  @@unique([connectedAccountId, providerEventId])
  @@index([companyId])
  @@index([companyId, startsAt])
}

model MailboxCalendarEventContact {
  id        String               @id @default(uuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventId   String
  event     MailboxCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId])
  @@index([companyId])
  @@index([contactId])
}
