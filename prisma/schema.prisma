generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AuthUser {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  companyId         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  authsessions      AuthSession[]
  authaccounts      AuthAccount[]
  oauthapplications OauthApplication[]
  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]

  @@unique([email])
  @@index([email])
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  authuser  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([token])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  authuser              AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  configId            String    @default("default")
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([key])
  @@index([referenceId])
}

model OauthApplication {
  id                String             @id
  name              String
  icon              String?
  metadata          String?
  clientId          String             @unique
  clientSecret      String?
  redirectUrls      String
  type              String
  disabled          Boolean?           @default(false)
  userId            String?
  authuser          AuthUser?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  oauthaccesstokens OauthAccessToken[]
  oauthconsents     OauthConsent[]

  @@index([userId])
}

model OauthAccessToken {
  id                    String           @id
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  oauthapplication      OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  authuser              AuthUser?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
}

model OauthConsent {
  id               String           @id
  clientId         String
  oauthapplication OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId           String
  authuser         AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes           String
  consentGiven     Boolean
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId])
}

model User {
  id                              String                  @id @default(uuid())
  email                           String                  @unique
  firstName                       String
  lastName                        String
  companyId                       String
  roleId                          String?
  role                            UserRole?               @relation(fields: [roleId], references: [id])
  status                          Status                  @default(pendingAuthorization)
  displayLanguage                 Locale                  @default(system)
  formattingLocale                Locale                  @default(system)
  auditLogs                       AuditLog[]
  theme                           Theme                   @default(system)
  country                         CountryCode             @default(de)
  avatarUrl                       String?
  agreeToTerms                    Boolean                 @default(false)
  lastActiveAt                    DateTime?
  welcomeEmailSentAt              DateTime?
  trialExpiredOfferSentAt         DateTime?
  trialInactivationReminderSentAt DateTime?
  trialInactivationNoticeSentAt   DateTime?
  onboardingWizardCompletedAt     DateTime?
  agentCreditActivatedAt          DateTime?
  isPlatformOperator              Boolean                 @default(false)
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  company                         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdTokens                   InviteToken[]           @relation("TokenCreator")
  deals                           DealUser[]
  contacts                        ContactUser[]
  organizations                   OrganizationUser[]
  services                        ServiceUser[]
  tasks                           TaskUser[]
  relatedTasks                    Task[]                  @relation("TaskRelatedUser")
  completedTasks                  Task[]                  @relation("TaskCompletedBy")
  widgets                         Widget[]
  p13n                            P13n[]
  dataViews                       DataView[]
  uploadedRecordFiles             RecordFile[]
  createdRecordDocuments          RecordDocument[]
  uploadedRecordDocumentFiles     RecordDocumentFile[]
  startedDuplicateScans           DuplicateScan[]
  duplicateDismissals             DuplicateDismissal[]
  contactMerges                   ContactMergeRecord[]    @relation("ContactMergeRecordMergedBy")
  undoneContactMerges             ContactMergeRecord[]    @relation("ContactMergeRecordUndoneBy")
  connectedAccounts               ConnectedAccount[]
  agentConversations              AgentConversation[]
  agentRunLeases                  AgentRunLease[]
  ownedRoutines                   Routine[]
  createdAutomations              Automation[]
  agentCreditAdjustments          AgentCreditAdjustment[]
  adAttributions                  AdAttribution[]
  dealStageHistories              DealStageHistory[]
  ownedLeads                      Lead[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([roleId])
}

model Company {
  id                           String                        @id @default(uuid())
  currency                     Currency                      @default(eur)
  dealWeightingColumnId        String?
  dealWeightingColumn          CustomColumn?                 @relation("CompanyDealWeightingColumn", fields: [dealWeightingColumnId], references: [id], onDelete: SetNull)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  tags                         String[]                      @default([])
  tasks                        Task[]
  users                        User[]
  adAttributions               AdAttribution[]
  conversionEvents             ConversionEvent[]
  inviteTokens                 InviteToken[]
  contacts                     Contact[]
  organizations                Organization[]
  deals                        Deal[]
  dealStageHistories           DealStageHistory[]
  pipelines                    Pipeline[]
  pipelineStages               PipelineStage[]
  lostReasons                  LostReason[]
  services                     Service[]
  CustomColumn                 CustomColumn[]
  auditLogs                    AuditLog[]
  customFieldValues            CustomFieldValue[]
  serviceDeals                 ServiceDeal[]
  dealOrganizations            DealOrganization[]
  dealUsers                    DealUser[]
  dealContacts                 DealContact[]
  contactUsers                 ContactUser[]
  contactOrganizations         ContactOrganization[]
  organizationUsers            OrganizationUser[]
  serviceUsers                 ServiceUser[]
  taskUsers                    TaskUser[]
  taskContacts                 TaskContact[]
  taskOrganizations            TaskOrganization[]
  taskDeals                    TaskDeal[]
  taskServices                 TaskService[]
  widgets                      Widget[]
  userRoles                    UserRole[]
  rolePermissions              RolePermission[]
  p13n                         P13n[]
  dataViews                    DataView[]
  recordFiles                  RecordFile[]
  mailAttachments              MailAttachment[]
  messageDeliveries            MessageDelivery[]
  messageDeliveryEvents        MessageDeliveryEvent[]
  bulkJobs                     BulkJob[]
  contactLists                 ContactList[]
  contactListMembers           ContactListMember[]
  campaigns                    Campaign[]
  campaignRecipients           CampaignRecipient[]
  leadAssignmentRules          LeadAssignmentRule[]
  mailDrafts                   MailDraft[]
  mailOutboxMessages           MailOutboxMessage[]
  mailLabels                   MailLabel[]
  mailboxCalendarEvents        MailboxCalendarEvent[]
  mailboxCalendarEventContacts MailboxCalendarEventContact[]
  messagingThreadLabels        MessagingThreadLabel[]
  messageTemplates             MessageTemplate[]
  messageSuppressions          MessageSuppression[]
  unsubscribeTokens            UnsubscribeToken[]
  senderIdentity               SenderIdentity?
  recordDocuments              RecordDocument[]
  duplicateScans               DuplicateScan[]
  duplicateGroups              DuplicateGroup[]
  duplicateMembers             DuplicateMember[]
  duplicateDismissals          DuplicateDismissal[]
  contactMatchKeys             ContactMatchKey[]
  contactMergeRecords          ContactMergeRecord[]
  organizationMergeRecords     OrganizationMergeRecord[]
  invoices                     Invoice[]
  invoiceLines                 InvoiceLine[]
  invoicePayments              InvoicePayment[]
  invoiceSettings              InvoiceSettings?
  billingProfiles              BillingProfile[]
  recordDocumentFiles          RecordDocumentFile[]
  webhooks                     Webhook[]
  webhookDeliveries            WebhookDelivery[]
  automations                  Automation[]
  automationSteps              AutomationStep[]
  automationRuns               AutomationRun[]
  automationRunSteps           AutomationRunStep[]
  connectedAccounts            ConnectedAccount[]
  mailboxCredentials           MailboxCredential[]
  messagingThreads             MessagingThread[]
  messagingMessages            MessagingMessage[]
  messagingThreadParticipants  MessagingThreadParticipant[]
  accountActivities            AccountActivity[]
  contactIdentifiers           ContactIdentifier[]
  calendars                    Calendar[]
  calendarEvents               CalendarEvent[]
  subscription                 Subscription?
  entityTerminology            EntityTerminology[]
  agentConversations           AgentConversation[]
  agentRunLeases               AgentRunLease[]
  agentRunRounds               AgentRunRound[]
  agentToolReceipts            AgentToolReceipt[]
  agentMessages                AgentMessage[]
  agentUsageEvents             AgentUsageEvent[]
  agentCreditAdjustments       AgentCreditAdjustment[]
  agentTurnRequests            AgentTurnRequest[]
  agentApprovals               AgentApproval[]
  agentUiCommandResults        AgentUiCommandResult[]
  routines                     Routine[]
  routineRuns                  RoutineRun[]
  leads                        Lead[]
  webFormSources               WebFormSource[]
  webFormSubmissions           WebFormSubmission[]
  webFormRateLimits            WebFormRateLimit[]
}

model EntityTerminology {
  id         String     @id @default(uuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType EntityType
  presetKey  String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([companyId, entityType])
  @@index([companyId])
}

model P13n {
  id               String   @id @default(uuid())
  userId           String
  companyId        String
  p13nId           String
  filters          Json?
  searchTerm       String?
  sortDescriptor   Json?
  pagination       Json?
  columnOrder      String[]
  columnWidths     Json?
  hiddenColumns    String[]
  viewMode         String?  @default("table")
  groupingColumnId String?
  grouping         Json?
  detailOptions    Json?
  activeViewKey    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, p13nId])
  @@index([companyId])
  @@index([userId])
}

model DataView {
  id               String   @id @default(uuid())
  companyId        String
  userId           String
  surfaceKey       String
  name             String
  position         Int      @default(0)
  filters          Json?
  searchTerm       String?
  sortDescriptor   Json?
  viewMode         String?
  groupingColumnId String?
  grouping         Json?
  columnOrder      Json?
  columnWidths     Json?
  hiddenColumns    Json?
  pageSize         Int?
  shared           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, surfaceKey, userId])
  @@index([companyId, surfaceKey, shared])
}

model Task {
  id                String             @id @default(uuid())
  type              TaskType
  companyId         String
  name              String
  relatedUserId     String?
  notes             Json?
  activityKind      ActivityKind?
  dueAt             DateTime?
  durationMinutes   Int?
  completedAt       DateTime?
  completedById     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  relatedUser       User?              @relation("TaskRelatedUser", fields: [relatedUserId], references: [id])
  completedBy       User?              @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  users             TaskUser[]
  contacts          TaskContact[]
  organizations     TaskOrganization[]
  deals             TaskDeal[]
  services          TaskService[]
  customFieldValues CustomFieldValue[]

  @@index([companyId])
  @@index([type, companyId])
  @@index([relatedUserId])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
  @@index([companyId, completedAt, dueAt])
  @@index([companyId, dueAt])
  @@index([completedById])
}

model InviteToken {
  id          String   @id @default(uuid())
  token       String   @unique
  companyId   String
  createdById String
  email       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TokenCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([companyId, expiresAt])
  @@index([companyId, email])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  event     String
  eventData Json
  createdAt DateTime @default(now())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId  String

  @@index([event])
  @@index([companyId])
  @@index([userId])
  @@index([entityId])
}

model Contact {
  id                    String                        @id @default(uuid())
  firstName             String
  lastName              String
  companyId             String
  avatarUrl             String?
  notes                 Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  company               Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizations         ContactOrganization[]
  listMemberships       ContactListMember[]
  users                 ContactUser[]
  deals                 DealContact[]
  tasks                 TaskContact[]
  customFieldValues     CustomFieldValue[]            @relation("ContactToCustomFieldValue")
  customFieldRefs       CustomFieldValue[]            @relation("CustomFieldValueTargetContact")
  identifiers           ContactIdentifier[]
  leads                 Lead[]
  files                 RecordFile[]
  documents             RecordDocument[]
  duplicateMembers      DuplicateMember[]
  matchKeys             ContactMatchKey[]
  mergeRecords          ContactMergeRecord[]
  mailboxCalendarEvents MailboxCalendarEventContact[]

  @@index([companyId])
  @@index([firstName])
  @@index([lastName])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
}

model Organization {
  id                String                @id @default(uuid())
  name              String
  companyId         String
  notes             Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts          ContactOrganization[]
  deals             DealOrganization[]
  users             OrganizationUser[]
  tasks             TaskOrganization[]
  customFieldValues CustomFieldValue[]    @relation("CustomFieldValueToOrganization")
  customFieldRefs   CustomFieldValue[]    @relation("CustomFieldValueTargetOrganization")
  leads             Lead[]
  files             RecordFile[]
  documents         RecordDocument[]
  duplicateMembers  DuplicateMember[]
  invoices          Invoice[]
  billingProfile    BillingProfile?
  matchKeys         ContactMatchKey[]

  @@index([companyId])
  @@index([name])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
}

model CustomColumn {
  id               String             @id @default(uuid())
  label            String
  type             CustomColumnType
  entityType       EntityType
  options          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  companyId        String
  Company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  CustomFieldValue CustomFieldValue[]
  weightingFor     Company[]          @relation("CompanyDealWeightingColumn")

  @@index([companyId])
  @@index([companyId, entityType])
}

model CustomFieldValue {
  id             String           @id @default(uuid())
  entityType     EntityType
  columnId       String
  value          String?
  rangeStart     String?          @default(dbgenerated("custom_field_range_start(value)"))
  rangeEnd       String?          @default(dbgenerated("custom_field_range_end(value)"))
  numericValue   Decimal?         @db.Decimal(20, 4)
  type           CustomColumnType
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  column         CustomColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?         @relation("ContactToCustomFieldValue", fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?    @relation("CustomFieldValueToOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?            @relation("CustomFieldValueToDeal", fields: [dealId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  targetContactId      String?
  targetContact        Contact?      @relation("CustomFieldValueTargetContact", fields: [targetContactId], references: [id], onDelete: Cascade)
  targetOrganizationId String?
  targetOrganization   Organization? @relation("CustomFieldValueTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  targetDealId         String?
  targetDeal           Deal?         @relation("CustomFieldValueTargetDeal", fields: [targetDealId], references: [id], onDelete: Cascade)

  @@index([entityType, columnId])
  @@index([columnId])
  @@index([columnId, value])
  @@index([value])
  @@index([rangeStart])
  @@index([rangeEnd])
  @@index([companyId])
  @@index([contactId])
  @@index([organizationId])
  @@index([dealId])
  @@index([serviceId])
  @@index([taskId])
  @@index([dealId, columnId])
  @@index([contactId, columnId])
  @@index([organizationId, columnId])
  @@index([serviceId, columnId])
  @@index([taskId, columnId])
  @@index([targetContactId])
  @@index([targetOrganizationId])
  @@index([targetDealId])
  @@index([leadId])
}

model Deal {
  id                String             @id @default(uuid())
  name              String
  baseValue         Float              @default(0)
  totalValue        Float              @default(0)
  totalQuantity     Float              @default(0)
  weightedValue     Float?
  companyId         String
  notes             Json?
  pipelineId        String?
  stageId           String?
  status            DealStatus         @default(open)
  expectedCloseDate DateTime?
  probability       Float?
  stageEnteredAt    DateTime?
  rottingAt         DateTime?
  lostReasonId      String?
  lostNotes         String?
  wonAt             DateTime?
  lostAt            DateTime?
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organizations     DealOrganization[]
  users             DealUser[]
  contacts          DealContact[]
  services          ServiceDeal[]
  tasks             TaskDeal[]
  customFieldValues CustomFieldValue[] @relation("CustomFieldValueToDeal")
  customFieldRefs   CustomFieldValue[] @relation("CustomFieldValueTargetDeal")
  pipeline          Pipeline?          @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage             PipelineStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  lostReason        LostReason?        @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  stageHistory      DealStageHistory[]
  files             RecordFile[]
  documents         RecordDocument[]
  mailThreads       MessagingThread[]
  invoices          Invoice[]

  @@index([companyId])
  @@index([name])
  @@index([createdAt])
  @@index([totalValue])
  @@index([totalQuantity])
  @@index([weightedValue])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
  @@index([companyId, pipelineId, stageId])
  @@index([companyId, status, closedAt])
  @@index([companyId, status, rottingAt])
  @@index([companyId, status, expectedCloseDate])
  @@index([expectedCloseDate])
  @@index([pipelineId])
  @@index([stageId])
  @@index([lostReasonId])
}

model Service {
  id                String             @id @default(uuid())
  name              String
  amount            Float
  companyId         String
  notes             Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users             ServiceUser[]
  deals             ServiceDeal[]
  tasks             TaskService[]
  customFieldValues CustomFieldValue[]

  @@index([companyId])
  @@index([name])
  @@index([companyId, createdAt])
  @@index([companyId, updatedAt])
}

model ServiceDeal {
  id        String   @id @default(uuid())
  serviceId String
  dealId    String
  quantity  Float    @default(1)
  unitPrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dealId])
  @@index([dealId])
  @@index([serviceId])
  @@index([companyId])
  @@index([companyId, serviceId])
  @@index([companyId, dealId])
}

model ServiceUser {
  id        String   @id @default(uuid())
  serviceId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
  @@index([serviceId])
  @@index([userId])
  @@index([companyId])
  @@index([companyId, userId])
}

model DealOrganization {
  id             String       @id @default(uuid())
  dealId         String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, organizationId])
  @@index([dealId])
  @@index([organizationId])
  @@index([companyId])
  @@index([companyId, organizationId])
  @@index([companyId, dealId])
}

model DealUser {
  id        String   @id @default(uuid())
  dealId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
  @@index([companyId])
  @@index([companyId, userId])
}

model DealContact {
  id        String   @id @default(uuid())
  dealId    String
  contactId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
  @@index([companyId])
  @@index([companyId, dealId])
  @@index([companyId, contactId])
}

model ContactUser {
  id        String   @id @default(uuid())
  contactId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
