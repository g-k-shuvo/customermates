APP_PORT=4000
APP_MODE=self-hosted

# Leave unset to build the app image from this checkout (docker compose build app).
# Set it to pull a published image instead, e.g. ghcr.io/<owner>/<repo>:latest
# APP_IMAGE=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=customermates

BASE_URL=http://localhost:4000

BETTER_AUTH_SECRET=change-this-to-a-long-random-secret

# Authorises the scheduled jobs the cron container runs against the app:
# mailbox sync every 5 minutes, webhook reprocessing and file cleanup hourly,
# lifecycle daily.
# The cron container refuses to start when this is empty, because the app
# answers 401 without it. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-this-to-a-long-random-secret

# Background jobs. docker-compose.yml sets all four on the app service, so you only need
# these when you deploy some other way -- a Kubernetes manifest, an ECS task definition, a
# hand-written compose file. Leave WORKFLOW_TARGET_WORLD unset off Vercel and the runtime
# silently selects an in-process world, starts no worker, and accepts every job without
# ever running it: mailbox sync, webhook delivery and agent turns all stop while the cron
# container still logs "ok". WORKFLOW_LOCAL_BASE_URL is the address the queue calls back
# to execute a run, and must match the port the app listens on.
# WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# WORKFLOW_POSTGRES_URL=postgresql://user:password@postgres:5432/customermates
# WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:4000
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=10

RESEND_API_KEY="XXX"
RESEND_OPERATOR_EMAIL=mail@your-company.com

# Email delivery: "resend" (default in production), "smtp", or "console" (writes each email to
# the server log instead of sending it; the default outside production)
EMAIL_TRANSPORT=resend

# Required when EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=smtp.your-provider.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_SECURE=false

# Seals IMAP mailbox passwords at rest (M7 email integration).
# Required only when a mailbox is connected. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back this up. Losing it makes every stored mailbox credential unrecoverable and
# every connected mailbox must be reconnected by hand.
# MAILBOX_SECRET_KEY=

# File storage: an S3-compatible bucket for uploaded and generated files.
# Leave every STORAGE_* variable unset to run without files; set the four
# required ones together or the app refuses to boot and names what is missing.
# Browsers upload straight to the bucket through links signed for
# STORAGE_PUBLIC_ENDPOINT (defaults to STORAGE_ENDPOINT), so that address must be
# the exact origin browsers reach, and the bucket must allow BASE_URL as a
# cross-origin caller: run `yarn storage:setup` from a checkout, or set the
# bucket's CORS in your provider's console. Keep the server clock in sync; a
# drift over 15 minutes breaks every signed link.
# STORAGE_ENDPOINT=https://s3.eu-central-1.example.com
# STORAGE_PUBLIC_ENDPOINT=
# STORAGE_BUCKET=customermates-files
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_MAX_UPLOAD_MB=25

# E-signature through DocuSign (JWT grant). Leave every DOCUSIGN_* variable unset
# to keep documents manual; set the four required ones together or the app refuses
# to boot and names what is missing. Signing also needs file storage above.
# Grant consent once as the API user, create a Connect HMAC key in DocuSign's admin
# settings, and make BASE_URL/api/webhooks/docusign reachable from DocuSign.
# DOCUSIGN_PRIVATE_KEY is the app's RSA key in PEM form; \n escapes are accepted.
# DOCUSIGN_AUTH_SERVER defaults to https://account.docusign.com; use
# https://account-d.docusign.com for the developer sandbox.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_CONNECT_HMAC_SECRET=
# DOCUSIGN_AUTH_SERVER=
# DOCUSIGN_ACCOUNT_ID=

# White-label name shown in the sidebar, the browser tab, email senders and
# email footers. Defaults to Customermates when unset.
# BRAND_NAME=

# Address offered to users who need help, in email footers and on the
# subscription recovery screen. Defaults to RESEND_OPERATOR_EMAIL when unset.
# BRAND_SUPPORT_EMAIL=

# Hides the Google and Microsoft buttons on sign-in and sign-up and refuses the
# matching server actions, even when OAuth credentials are configured below.
# Accepts only "true" or "false". Defaults to false.
# AUTH_SOCIAL_LOGIN_DISABLED=false

# Strips the public marketing navbar down to the language switcher and the theme
# toggle, for deployments where sign-in is the front door.
# Accepts only "true" or "false". Defaults to false.
# MARKETING_CHROME_DISABLED=false

# Hides the vendor Documentation and Feedback entries at the foot of the app
# sidebar. Accepts only "true" or "false". Defaults to false.
# VENDOR_HELP_DISABLED=false

# Optional: show "Continue with Google / Microsoft" on sign-in and sign-up
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
