APP_PORT=4000
APP_MODE=self-hosted

# Leave unset to build the app image from this checkout (docker compose build app).
# Set it to pull a published image instead, e.g. ghcr.io/<owner>/<repo>:latest
# APP_IMAGE=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=customermates

BASE_URL=http://localhost:4000

BETTER_AUTH_SECRET=change-this-to-a-long-random-secret

RESEND_API_KEY="XXX"
RESEND_OPERATOR_EMAIL=mail@your-company.com

# Email delivery: "resend" (default) or "smtp"
EMAIL_TRANSPORT=resend

# Required when EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=smtp.your-provider.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_SECURE=false

# Seals IMAP mailbox passwords at rest (M7 email integration).
# Required only when a mailbox is connected. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back this up. Losing it makes every stored mailbox credential unrecoverable and
# every connected mailbox must be reconnected by hand.
# MAILBOX_SECRET_KEY=

# Optional: show "Continue with Google / Microsoft" on sign-in and sign-up
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
